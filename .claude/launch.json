{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laravel",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--port=8000"],
      "port": 8000
    },
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "queue",
      "runtimeExecutable": "nice",
      "runtimeArgs": ["-n", "15", "php", "artisan", "queue:listen", "--tries=1", "--timeout=0"],
      "port": 0
    },
    {
      "name": "ollama",
      "runtimeExecutable": "env",
      "runtimeArgs": ["OLLAMA_KEEP_ALIVE=10s", "OLLAMA_MAX_LOADED_MODELS=1", "ollama", "serve"],
      "port": 11434
    }
  ]
}
